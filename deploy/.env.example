# ==================== JWT ====================
# JWT 签名密钥，生产环境请替换为随机字符串
JWT_KEY=Airiseina

# ==================== SeaweedFS 对象存储 (api_gateway/msg_gateway/knowledge_service) ====================
# filer 内网地址在 docker-compose 中已通过 SEAWEEDFS_FILER_URL 注入

# 文件存储基础路径
SEAWEEDFS_BASE_PATH=/chat
# 对外暴露的文件访问 URL 前缀
SEAWEEDFS_PUBLIC_URL=/files

# ==================== Kafka 消息队列 (msg_gateway/knowledge_service/work_service) ====================
# broker 内网地址在 docker-compose 中已通过 KAFKA_BROKERS 注入

# 文档解析队列 topic
KAFKA_TOPIC_DOC_PARSE=doc-parse
# 知识库消费者组
KAFKA_GROUP_KNOWLEDGE=knowledge-group

# ==================== MySQL (user/group/bot/knowledge) ====================
# 容器内网地址，若连接外部 MySQL 请改为对应 IP
MYSQL_HOST=mysql
# MySQL 端口
MYSQL_PORT=3306
# 数据库用户名 (root)
MYSQL_USER=root
# 数据库密码
MYSQL_PASSWORD=123456
# 数据库名
MYSQL_NAME=answer

# ==================== PostgreSQL (chat_service) ====================
# 容器内网地址，若连接外部 PostgreSQL 请改为对应 IP
POSTGRES_HOST=postgres
# PostgreSQL 端口
POSTGRES_PORT=5432
# 数据库用户名
POSTGRES_USER=postgres
# 数据库密码
POSTGRES_PASSWORD=123456
# 数据库名
POSTGRES_DBNAME=answer_chat

# ====================clickhouse========================
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=123456
CLICKHOUSE_DB=answer_cold
# ==================== Redis / Garnet 缓存 (chat_service) ====================
# 格式: host:port
REDIS_ADDR=garnet:6379


# ==================== Meilisearch 搜索数据库 (knowledge_service) ====================
# Meilisearch API Key (MEILISEARCH_API_KEY)
MEILISEARCH_API_KEY=Airiseina_answer_key

# ==================== Embedding 向量模型 (knowledge_service) ====================
# 火山引擎 / OpenAI 兼容 API Key
EMBEDDING_API_KEY=
# API 地址 (火山引擎 / OpenAI 兼容)
EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 向量模型名称
EMBEDDING_MODEL=doubao-embedding-vision-251215

# ==================== LLM 大语言模型 (knowledge_service) ====================
# 用于实体抽取/关键词抽取等图谱构建任务
# 火山引擎 / OpenAI 兼容 API Key
LLM_API_KEY=
# API 地址 (火山引擎 / OpenAI 兼容)
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 对话模型名称，留空时实体抽取将降级为 N-gram 正则方案
# 示例：doubao-seed-1-8-251228 / deepseek-v4-flash
LLM_MODEL=

# ==================== AI 系统 Bot (bot_service) ====================

# Bot 名称
AI_SYSTEM_BOT_NAME=kiana
# 系统 Prompt 文本
AI_SYSTEM_BOT_PROMPT=你是AIM助手，一个智能AI助手。你可以回答问题、总结对话、查询天气、翻译文本等。请用中文回复。
# 系统 Prompt 文件路径 (容器内路径)
AI_SYSTEM_BOT_PROMPT_FILE=prompt/system_bot_prompt.md
# Bot 技能文件目录 (容器内路径)
AI_SYSTEM_BOT_SKILL_DIR=prompt/skills/kiana.skill
# 大模型名称
AI_SYSTEM_BOT_MODEL=doubao-seed-1-8-251228
# API 地址 (火山引擎 / OpenAI 兼容)
AI_SYSTEM_BOT_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# API Key
AI_SYSTEM_BOT_API_KEY=


# ==================== MCP Mem0 记忆层 ====================

# Mem0 API Key (自部署留空即可)
MEM0_API_KEY=

# Mem0 大模型配置
MEM0_LLM_API_KEY=
MEM0_LLM_BASE_URL=https://api.deepseek.com/v1
MEM0_LLM_MODEL=deepseek-v4-flash

# Mem0 向量模型配置
MEM0_EMBEDDING_API_KEY=
MEM0_EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
MEM0_EMBEDDING_MODEL=doubao-embedding-vision-251215
# 向量服务提供商: volcengine / openai
MEM0_EMBEDDING_PROVIDER=volcengine
# 向量维度
MEM0_EMBEDDING_DIMS=2048

# ==================== MCP Knowledge 知识库 ====================

# 向量模型 API Key
KNOWLEDGE_DOUBAO_EMBEDDING_API_KEY=
# API 地址
KNOWLEDGE_EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 向量模型名称
KNOWLEDGE_EMBEDDING_MODEL=doubao-embedding-vision-251215
# 向量维度
KNOWLEDGE_EMBEDDING_DIMS=2048

# ==================== Rerank 精排服务 ====================

# 是否启用Rerank精排 (true/false)
RERANK_ENABLED=true
# Rerank模式: jina(云端API) 或 vllm(本地GPU部署)
# 注意: jina模式同时兼容硅基流动API（国内推荐，延迟更低），只需修改 BASE_URL 和 MODEL 即可
RERANK_MODE=jina
# Rerank服务地址
# 硅基流动(国内推荐): https://api.siliconflow.cn/v1  ← 免费2000万token，国内低延迟
# Jina(海外): https://api.jina.ai/v1
# vllm(本地GPU): http://answer_rerank:8000/v1
RERANK_BASE_URL=https://api.siliconflow.cn/v1
# Rerank模型名称
# 硅基流动: BAAI/bge-reranker-v2-m3
# Jina: jina-reranker-v2-base-multilingual
# vllm: BAAI/bge-reranker-v2-m3
RERANK_MODEL=Qwen/Qwen3-Reranker-8B
# 精排后保留的Top-N结果数
RERANK_TOP_N=3
# Rerank API Key
# 硅基流动: https://cloud.siliconflow.cn 申请（免费2000万token）
# Jina: https://jina.ai/reranker 获取（免费额度1000万token）
RERANK_API_KEY=

# ==================== RAGAS 评估服务 ====================

# RAGAS评估服务地址（留空则禁用自动评估）
# 本地运行: http://localhost:8090
# Docker运行: 由docker-compose.yml中的RAGAS_EVAL_URL环境变量覆盖
RAGAS_EVAL_URL=http://localhost:8090

# RAGAS评估用LLM API Key
RAGAS_LLM_API_KEY=
# RAGAS评估用LLM API地址
RAGAS_LLM_BASE_URL=https://api.deepseek.com/v1
# RAGAS评估用LLM模型
RAGAS_LLM_MODEL=deepseek-v4-flash
# RAGAS评估用Embedding API Key
RAGAS_EMBEDDING_API_KEY=
# RAGAS评估用Embedding API地址
RAGAS_EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# RAGAS评估用Embedding模型
RAGAS_EMBEDDING_MODEL=doubao-embedding-vision-251215
